{
  "name": "weftcut",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Stich local video editor with transcript editing and MCP tools, based on WeftCut",
  "author": "UncleChair (https://github.com/UncleChair)",
  "homepage": "https://github.com/OsirisMedici/Stich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OsirisMedici/Stich.git"
  },
  "bugs": {
    "url": "https://github.com/OsirisMedici/Stich/issues"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "version:release": "node apps/desktop/scripts/release.mjs version",
    "bootstrap": "npm --workspace apps/desktop run bootstrap",
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "test": "npm --workspace apps/desktop run test --",
    "test:scripts": "npm --workspace apps/desktop run test:scripts",
    "e2e": "npm --workspace apps/desktop run e2e --",
    "build:e2e": "npm --workspace apps/desktop run build:e2e",
    "package": "npm --workspace apps/desktop run package",
    "knip": "npx --yes knip"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
